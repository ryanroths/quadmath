{
  "_comment": "Policy for agent-authored pull requests. This file is ALWAYS loaded from the merge-base commit, never from the PR head, so a PR cannot relax its own guardrails. Edits here require a human reviewer (see deny_paths: scripts/ci/**).",

  "max_changed_lines": 200,
  "max_changed_files": 12,
  "max_new_files": 6,

  "allow_paths": [
    "data/tunes/*.json",
    "data/gear/*.json",
    "data/builds/*.json",
    "content/tunes/*.html",
    "content/guides/*.html",
    "tune-database.html",
    "gear.html",
    "go/*/index.html",
    "go_map.json"
  ],

  "deny_paths": [
    "sim.html",
    "sim/**",
    "assets/sim/**",
    ".github/**",
    "scripts/ci/**",
    "CNAME",
    "robots.txt",
    "sitemap.xml",
    "**/*.py",
    "**/*.yml",
    "**/*.sh"
  ],

  "html_checks": {
    "forbid_inline_script": true,
    "_allow_jsonld_comment": "Exempts <script type=\"application/ld+json\"> from forbid_inline_script, but only when the block contains valid JSON. Every other inline script stays forbidden, including type=\"text/javascript\". Defaults to true when the key is absent; set false to restore the blanket ban.",
    "allow_jsonld": true,
    "allowed_script_hosts": [
      "static.cloudflareinsights.com"
    ],
    "require_meta_description": true
  },

  "link_checks": {
    "check_internal": true,
    "allowed_external_hosts": [
      "betafpv.com",
      "webleedfpv.com",
      "bit.ly",
      "quadmath.com",
      "github.com",
      "betaflight.com",
      "fonts.googleapis.com",
      "fonts.gstatic.com",
      "www.youtube.com",
      "www.instagram.com",
      "www.racedayquads.com"
    ]
  },

  "bench_schema": {
    "_comment": "Schema for data/bench/<slug>.json files: first-hand measured data for one build, keyed by the build_orphan slug. The generator refuses to write a build_orphan guide unless a file matching this schema exists at origin/main. Same validation style as tune_schema: required fields, numeric ranges, placeholder rejection, and a source that names how the numbers were measured.",
    "required_fields": [
      "build_id",
      "frame_size_mm",
      "motor",
      "motor_kv",
      "prop",
      "battery",
      "auw_g",
      "hover_time_s",
      "freestyle_time_s",
      "source"
    ],
    "optional_fields": [
      "top_speed_mph",
      "max_current_a",
      "notes"
    ],
    "string_fields": [
      "build_id",
      "motor",
      "prop",
      "battery",
      "source",
      "notes"
    ],
    "numeric_ranges": {
      "frame_size_mm": [50, 120],
      "motor_kv": [5000, 45000],
      "auw_g": [15, 120],
      "hover_time_s": [30, 1200],
      "freestyle_time_s": [30, 1200],
      "top_speed_mph": [5, 120],
      "max_current_a": [1, 100]
    },
    "source_must_contain_any": [
      "measured",
      "bench",
      "gps",
      "osd",
      "blackbox",
      "stopwatch",
      "logged",
      "verified"
    ],
    "placeholder_values": [
      "TBD",
      "TODO",
      "FIXME",
      "XXX",
      "N/A",
      "???"
    ]
  },

  "tune_schema": {
    "required_fields": [
      "id",
      "name",
      "frame_size_mm",
      "fc",
      "motor_kv",
      "prop",
      "rate_type",
      "pids",
      "source"
    ],
    "string_fields": [
      "id",
      "name",
      "fc",
      "prop",
      "source"
    ],
    "frame_size_mm_min": 50,
    "frame_size_mm_max": 120,
    "pid_axes": [
      "roll",
      "pitch",
      "yaw"
    ],
    "pid_terms": [
      "p",
      "i",
      "d"
    ],
    "pid_min": 0,
    "pid_max": 255,
    "rate_types": [
      "BETAFLIGHT",
      "ACTUAL",
      "QUICK",
      "RACEFLIGHT",
      "KISS"
    ],
    "source_must_contain_any": [
      "cli",
      "dump",
      "diff",
      "verified"
    ],
    "placeholder_values": [
      "TBD",
      "TODO",
      "FIXME",
      "XXX",
      "N/A",
      "???"
    ]
  }
}
